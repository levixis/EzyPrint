rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDocExists() {
      return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() &&
        userDocExists() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.type == 'ADMIN';
    }

    function isShopOwner() {
      return isSignedIn() &&
        userDocExists() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.type == 'SHOP_OWNER';
    }
    
    // Specific rules for the orders path
    match /orders/{userId}/{orderId}/{allPaths=**} {
      // Allow students to upload files only to their own order folder, AND enforce strict MIME types + SIZE LIMIT (50MB) + DOC ENFORCEMENT
      allow write: if request.auth != null && 
                   request.auth.uid == userId &&
                   request.resource.size < 50 * 1024 * 1024 &&
                   request.resource.contentType.matches('application/pdf|image/jpeg|image/png|image/webp|application/vnd\\.openxmlformats-officedocument\\.presentationml\\.presentation') &&
                   firestore.exists(/databases/(default)/documents/orders/$(orderId)) &&
                   firestore.get(/databases/(default)/documents/orders/$(orderId)).data.userId == request.auth.uid &&
                   firestore.get(/databases/(default)/documents/orders/$(orderId)).data.status == 'PENDING_PAYMENT';

      // PREVENT PRIVACY LEAK: Only allow the student, the canonical shop owner, or admin to read.
      // IMPORTANT: Firebase Storage rules have a hard limit of 5 firestore.get() calls per request.
      // We compare order.shopId against the shopId stored on the user document directly,
      // avoiding deeply nested get() calls that exceed the limit.
      allow read: if isSignedIn() && (
        // Branch 1: Student owns this folder (0 extra lookups)
        request.auth.uid == userId ||
        // Branch 2: Admin (1 exists + 1 get)
        isAdmin() ||
        // Branch 3: Shop owner — compare order's shopId with shopId on the user doc (2 gets)
        (
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.type == 'SHOP_OWNER' &&
          firestore.get(/databases/(default)/documents/orders/$(orderId)).data.shopId ==
            firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.shopId
        )
      );
    }

    // Specific rules for support tickets path
    match /tickets/{ticketId}/{allPaths=**} {
      allow write: if isSignedIn() && (
        firestore.exists(/databases/(default)/documents/tickets/$(ticketId)) &&
        firestore.get(/databases/(default)/documents/tickets/$(ticketId)).data.raisedBy == request.auth.uid
      ) && request.resource.size < 5 * 1024 * 1024
      && request.resource.contentType.matches('image/jpeg|image/png|image/webp|application/pdf|text/plain');
      
      allow read: if isSignedIn() && (
        (
          firestore.exists(/databases/(default)/documents/tickets/$(ticketId)) &&
          firestore.get(/databases/(default)/documents/tickets/$(ticketId)).data.raisedBy == request.auth.uid
        ) ||
        isAdmin() ||
        (
          isShopOwner() &&
          firestore.exists(/databases/(default)/documents/tickets/$(ticketId)) &&
          firestore.get(/databases/(default)/documents/tickets/$(ticketId)).data.get('shopId', null) == firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('shopId', '')
        )
      );
    }

    // Everything else defaults to closed
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

// EzyPrint Database Schema
// Mapped 1:1 from the existing types.ts — every Firestore collection
// becomes a proper relational table with foreign keys and indexes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection (Neon PgBouncer, the `-pooler` host) — used at runtime.
  url       = env("DATABASE_URL")
  // Direct connection (no PgBouncer) — used by `prisma migrate` only.
  // PgBouncer in transaction mode cannot hold the session-level advisory locks
  // migrations take, so DDL run through the pooler fails or deadlocks.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS — PostgreSQL native enums for type safety
// ─────────────────────────────────────────────────────────────

enum UserType {
  STUDENT
  SHOP_OWNER
  ADMIN
}

enum PrintColor {
  BLACK_WHITE
  COLOR
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING_APPROVAL
  PRINTING
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
  PAYMENT_FAILED
  REFUNDED
}

/// Payout lifecycle.
///
/// IN_TRANSIT sits between approval and arrival: the transfer has been
/// initiated but the shop's bank has not credited it yet. Without it, a shop
/// owner sees "paid" and an unchanged bank balance, and reports missing money.
enum PayoutStatus {
  IN_TRANSIT
  PENDING
  PAID
  CONFIRMED
  DISPUTED
  REJECTED
  CANCELLED
}

enum PayoutMethodType {
  BANK_ACCOUNT
  UPI
}

enum BankAccountType {
  SAVINGS
  CURRENT
}

enum TicketCategory {
  ORDER_ISSUE
  PAYMENT_ISSUE
  DELIVERY_ISSUE
  OTHER
}

enum TicketStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum LedgerEntryType {
  ORDER_EARNING
  REFUND_DEDUCTION
  PAYOUT
  MANUAL_PAYOUT_DEDUCTION
  PAYOUT_CANCEL_REFUND
  PAYOUT_REJECT_REFUND
  CLAWBACK
  ADJUSTMENT
}

enum LedgerEntryStatus {
  PENDING
  SETTLED
  VOID
}

enum LedgerCounterparty {
  PLATFORM
  SHOP
  STUDENT
}

enum LedgerCreatedBy {
  SYSTEM
  ADMIN
  SHOP
}

enum NotificationType {
  success
  info
  warning
  error
}

enum RefundRequestStatus {
  PENDING_SHOP
  APPROVED_BY_SHOP
  REJECTED_BY_SHOP
  ESCALATED_TO_ADMIN
  AUTO_ESCALATED
  PROCESSING_REFUND
  RESOLVED_REFUNDED
  REFUND_SETTLED_OFFLINE
  RESOLVED_DENIED
  /// Razorpay accepted the refund, then failed it asynchronously. The shop's
  /// ledger deduction has been reversed and an admin must retry.
  REFUND_FAILED
}

/// Lifecycle of one Student Pass checkout.
enum StudentPassPurchaseStatus {
  /// Minted at the gateway, awaiting payment. At most one per user — see the
  /// partial unique index in the migration.
  OPEN
  /// Captured and applied to the student's pass.
  PAID
  /// Expired without payment, or given up on. The row is kept, not deleted:
  /// a late capture must still find the purchase it belongs to.
  ABANDONED
  /// Captured but refused — the sum did not match the price. Money moved and
  /// nothing was delivered, so this needs a human.
  REFUSED
}

enum ReactivationRequestStatus {
  pending
  approved
  rejected
}

// ─────────────────────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────────────────────

/// Core user model — students, shop owners, and admins
model User {
  id        String   @id @default(cuid())
  type      UserType
  name      String?
  email     String?  @unique
  phone     String?
  password  String?  // bcrypt hash — null for Google OAuth users

  // Google OAuth fields
  googleId  String?  @unique
  profilePhotoUrl String?

  // Student Pass
  hasStudentPass         Boolean   @default(false)
  /// Start of the 30-day window currently in force.
  ///
  /// May be in the *future*: a second purchase while a pass is live stacks, so
  /// the new window begins where the live one ends. `isStudentPassActive` asks
  /// `now < activatedAt + PASS_DURATION_MS`, which stays true across the gap.
  studentPassActivatedAt DateTime?
  studentPassPaymentId   String?


  // Push notification tokens
  fcmTokens String[] @default([])

  // Preferences
  preferredLanguage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Relations ──
  shop              Shop?          @relation("ShopOwner")
  orders            Order[]
  notifications     Notification[]
  ticketsRaised     Ticket[]       @relation("TicketRaiser")
  ticketMessages    TicketMessage[]
  bankAccessLogs    BankAccessLog[]
  refundRequests    RefundRequest[] @relation("RefundStudent")
  reactivationRequests ReactivationRequest[]
  refreshTokens     RefreshToken[]
  passPurchases     StudentPassPurchase[]
  referralCodesIssued ReferralCode[] @relation("ReferralCreator")
  referralCodeUsed    ReferralCode?  @relation("ReferralUser")

  @@index([type])
  @@index([email])
  @@map("users")
}

/// Refresh tokens for JWT rotation — stored server-side for revocation
model RefreshToken {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique  // SHA-256 hash of the actual token
  expiresAt   DateTime
  deviceInfo  String?           // User-Agent or device identifier
  ip          String?
  isRevoked   Boolean  @default(false)

  createdAt   DateTime @default(now())

  // ── Relations ──
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Print shop profile — owned by a SHOP_OWNER user
model Shop {
  id           String  @id @default(cuid())
  ownerUserId  String  @unique
  name         String
  address      String

  // Pricing
  bwPerPage    Int   @default(100)
  colorPerPage Int   @default(300)

  // Status
  isOpen       Boolean @default(false)
  isApproved   Boolean @default(false)
  isArchived   Boolean @default(false)
  isVerified   Boolean @default(false)
  isRejected   Boolean @default(false)
  rejectionReason String?

  // Contact info
  contactPhone    String?
  contactPhoneAlt String?
  contactEmail    String?
  whatsappNumber  String?

  // Ledger balances (denormalized for fast reads)
  pendingBalance   Int    @default(0)
  ledgerBalance    Int    @default(0)
  debtAmount       Int    @default(0)
  lastSettlementAt DateTime?
  financialVersion Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Relations ──
  owner              User                  @relation("ShopOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  orders             Order[]
  payoutMethods      PayoutMethod[]
  bankDetails        BankDetails?
  payouts            Payout[]
  ledgerEntries      LedgerEntry[]
  aggregate          ShopAggregate?
  tickets            Ticket[]              @relation("ShopTickets")
  refundRequests     RefundRequest[]
  reactivationRequests ReactivationRequest[]

  @@index([isOpen, isApproved, isArchived])
  @@index([ownerUserId])
  @@map("shops")
}

/// Document print order — placed by a student at a shop
model Order {
  id        String      @id @default(cuid())
  userId    String
  shopId    String
  status    OrderStatus @default(PENDING_PAYMENT)

  // Legacy single-file fields (backward compat)
  fileName        String
  fileType        String
  fileStoragePath String?
  fileSizeBytes   Int?
  isFileDeleted   Boolean @default(false)

  // Denormalized shop name (for display when shop is deleted)
  shopName    String?
  deletedShop Boolean @default(false)

  // Print options (embedded — these don't need their own table)
  copies      Int          @default(1)
  color       PrintColor   @default(BLACK_WHITE)
  pages       Int          @default(1)
  doubleSided Boolean      @default(false)
  startPage   Int?
  endPage     Int?

  // Pricing breakdown
  pageCost   Int @default(0)
  baseFee    Int @default(0)
  totalPrice Int @default(0)

  // Order metadata
  shopNotes           String?
  pickupCode          String?
  specialInstructions String?
  userName            String?
  isPremiumOrder      Boolean @default(false)

  // Payment tracking
  // razorpayOrderId is unique so the database itself rejects a second Razorpay
  // order being attached to any EzyPrint order. Postgres permits many NULLs in
  // a unique index, so unpaid orders are unaffected.
  razorpayOrderId   String? @unique
  razorpayPaymentId String?
  paymentAttemptedAt DateTime?
  /// Which path confirmed this payment: 'signature', 'webhook', 'recovery', or
  /// 'signature_mismatch' / 'webhook_failed' when one refused it.
  ///
  /// Provenance only. `flagForReview` used to overwrite this with
  /// 'amount_mismatch' to dedup its own alert, which destroyed the record of how
  /// a payment was verified for exactly the orders under investigation. The flag
  /// has its own columns below now.
  paymentVerifiedVia String?

  /// Why this order needs a human, in the words the alert used.
  ///
  /// Doubles as the alert's dedup key: the reconciliation sweep revisits the same
  /// stuck order every fifteen minutes, and re-mailing the admins each time is
  /// how an alert becomes something you mute. A *different* reason still
  /// announces, because a second, distinct problem on one order is news.
  needsReviewReason String?
  /// When it was first flagged. Never cleared automatically — an operator
  /// resolving the underlying problem is what ends it.
  flaggedForReviewAt DateTime?

  /// Hash of the file set this order's price was computed from, stamped at the
  /// moment the Razorpay order is created and never rewritten.
  ///
  /// The price is frozen when the gateway order is minted, so "the files the
  /// student was charged for" and "the files the shop is handed" are only the
  /// same thing if something checks. This is that something: at capture, the
  /// current file set is re-hashed and compared, and a mismatch means the order
  /// is not fulfilled — it is flagged for a human instead.
  ///
  /// Nullable, and null means "no fingerprint was recorded". Orders created
  /// before this column existed carry null and are not blocked by a check they
  /// could never satisfy.
  pricedFilesFingerprint String?

  // Refund tracking
  refundId                   String?
  refundStatus               String?
  refundAmount               Int?
  refundedAt                 DateTime?
  refundError                String?
  refundInitiatedBy          String?
  refundReason               String?
  refundProcessingStartedAt  DateTime?

  // Lifecycle timestamps
  uploadedAt  DateTime  @default(now())
  cancelledAt DateTime?
  completedAt DateTime?

  // Ledger link
  ledgerEntryId String?

  // ── Relations ──
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop           Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  files          OrderFile[]
  refundRequest  RefundRequest?

  @@index([userId])
  @@index([shopId])
  @@index([status])
  @@index([shopId, status])
  @@index([status, paymentAttemptedAt])  // reconciliation sweep for stuck payments
  @@map("orders")
}

/// Individual file within a multi-file order
model OrderFile {
  id            String     @id @default(cuid())
  uploadId      String?    @unique // Idempotency key for file uploads
  orderId       String
  fileName      String
  fileType      String
  fileStoragePath String?
  fileSizeBytes Int?
  isFileDeleted Boolean    @default(false)
  /// Page count as claimed by the client when the order was created. A hint
  /// for display only — never trust it for pricing.
  pageCount     Int        @default(1)
  /// Page count the server counted from the uploaded bytes. Null until the
  /// file is uploaded. This is the only figure pricing may use.
  verifiedPageCount Int?
  color         PrintColor @default(BLACK_WHITE)
  copies        Int        @default(1)
  doubleSided   Boolean    @default(false)

  createdAt DateTime @default(now())

  // ── Relations ──
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_files")
}

/// In-app notification for a user
model Notification {
  id               String           @id @default(cuid())
  recipientUserId  String
  message          String
  type             NotificationType @default(info)
  read             Boolean          @default(false)

  // Optional targeting metadata
  orderId        String?
  targetUserType UserType?
  targetShopId   String?

  createdAt DateTime @default(now())

  // ── Relations ──
  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, read])
  @@index([recipientUserId, createdAt])
  @@map("notifications")
}

/// Shop payout method (bank account or UPI)
model PayoutMethod {
  id                String          @id @default(cuid())
  shopId            String
  type              PayoutMethodType
  accountHolderName String?
  accountNumber     String?
  ifscCode          String?
  bankName          String?
  upiId             String?
  isPrimary         Boolean         @default(false)
  nickname          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Relations ──
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@map("payout_methods")
}

/// Sensitive bank details — restricted access, separate from PayoutMethod
model BankDetails {
  id                String          @id @default(cuid())
  shopId            String          @unique
  accountHolderName String
  bankName          String
  accountNumber     String          // Stored encrypted or plain, masked in UI
  ifscCode          String
  accountType       BankAccountType @default(SAVINGS)
  upiId             String?

  isVerified Boolean   @default(false)
  verifiedAt DateTime?
  verifiedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Relations ──
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("bank_details")
}

/// Audit log for bank detail access
model BankAccessLog {
  id        String   @id @default(cuid())
  shopId    String?
  targetId  String?
  userId    String
  userRole  UserType
  action    String   // VIEW, EDIT, VERIFY
  success   Boolean  @default(true)
  ip        String?

  createdAt DateTime @default(now())

  // ── Relations ──
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("bank_access_logs")
}

/// Shop payout record — tracks money paid out to shops
model Payout {
  id             String       @id @default(cuid())
  shopId         String
  shopName       String
  amount         Int
  status         PayoutStatus @default(PENDING)
  payoutOrderIds String[]     @default([])
  adminNote      String?
  shopOwnerNote  String?

  createdAt   DateTime  @default(now())
  paidAt      DateTime?
  confirmedAt DateTime?

  // ── Relations ──
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([status])
  @@index([shopId, status])
  @@map("payouts")
}

/// Support ticket raised by users
model Ticket {
  id             String         @id @default(cuid())
  raisedBy       String
  raisedByType   UserType
  raisedByName   String
  raisedByEmail  String?
  shopId         String?
  shopName       String?
  deletedShop    Boolean        @default(false)
  relatedOrderId String?
  subject        String
  category       TicketCategory
  description    String
  status         TicketStatus   @default(OPEN)
  attachmentPaths String[]      @default([])

  // Timestamps for tracking response times
  adminLastRepliedAt  DateTime?
  raiserLastRepliedAt DateTime?
  shopLastRepliedAt   DateTime?
  attachmentsCleanedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Relations ──
  raiser        User            @relation("TicketRaiser", fields: [raisedBy], references: [id], onDelete: Cascade)
  shop          Shop?           @relation("ShopTickets", fields: [shopId], references: [id], onDelete: SetNull)
  messages      TicketMessage[]
  statusHistory TicketStatusChange[]
  attachments   TicketAttachment[]

  @@index([raisedBy])
  @@index([shopId])
  @@index([status])
  @@map("tickets")
}

/// Individual message within a support ticket
model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  senderId   String
  senderName String
  senderType UserType
  message    String

  createdAt DateTime @default(now())

  // ── Relations ──
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_messages")
}

/// Status change audit trail for tickets
model TicketStatusChange {
  id            String       @id @default(cuid())
  ticketId      String
  from          TicketStatus
  to            TicketStatus
  changedBy     String
  changedByName String
  note          String?

  createdAt DateTime @default(now())

  // ── Relations ──
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_status_changes")
}

/// Durable attachment records for tickets
model TicketAttachment {
  id              String   @id @default(cuid())
  uploadId        String?  @unique // Idempotency key for file uploads
  ticketId        String
  /// The reply this file was sent with, so it renders inside the conversation
  /// rather than in a separate pile. Null for files attached when the ticket
  /// was first raised, which belong to the ticket itself.
  messageId       String?
  storageKey      String
  originalName    String
  mimeType        String
  sizeBytes       Int?
  
  createdAt       DateTime @default(now())

  // ── Relations ──
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([messageId])
  @@map("ticket_attachments")
}

/// Financial ledger entry for a shop — double-entry style
model LedgerEntry {
  id           String             @id @default(cuid())
  eventId      String?            @unique // Deterministic dedup key
  shopId       String
  orderId      String?
  type         LedgerEntryType
  status       LedgerEntryStatus  @default(PENDING)
  amount       Int
  counterparty LedgerCounterparty
  description  String
  createdBy    LedgerCreatedBy    @default(SYSTEM)

  createdAt DateTime  @default(now())
  settledAt DateTime?

  /// When this entry becomes withdrawable.
  ///
  /// Stamped when the entry is created rather than computed when the settlement
  /// sweep runs, so the dashboard can promise the shop owner an exact date the
  /// moment they earn the money instead of showing a vague rolling window.
  availableAt DateTime?

  // ── Relations ──
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([shopId, type, status])
  @@index([shopId, status])
  @@index([status, availableAt])  // drives the settlement sweep
  @@map("ledger_entries")
}

/// Outbox for real-time events (Pusher).
///
/// Rows are written inside the same transaction as the ledger write they
/// describe, so an event can never announce money movement that later rolled
/// back, and a committed movement can never fail to be announced. A dispatcher
/// publishes them after commit; the request path also publishes immediately for
/// latency, leaving the dispatcher as the crash-recovery sweep.
model RealtimeOutbox {
  id      String @id @default(cuid())
  channel String
  event   String
  payload Json

  /// Shop.financialVersion at write time — monotonic per shop, so a client can
  /// discard events that arrive out of order and detect gaps.
  seq Int

  publishedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?

  createdAt DateTime @default(now())

  @@index([publishedAt, createdAt])
  @@map("realtime_outbox")
}

/// Pre-computed shop aggregate stats (denormalized for dashboard performance)
model ShopAggregate {
  id                String @id @default(cuid())
  shopId            String @unique
  totalOrders       Int    @default(0)
  activeOrders      Int    @default(0)
  completedOrders   Int    @default(0)
  totalRevenue      Int  @default(0)
  totalBaseFees     Int  @default(0)
  totalPaidOut      Int  @default(0)
  pendingPayouts    Int  @default(0)
  pendingPayoutCount Int   @default(0)

  updatedAt DateTime @updatedAt

  // ── Relations ──
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("shop_aggregates")
}

/// Reactivation request for archived shops
model ReactivationRequest {
  id              String                     @id @default(cuid())
  shopId          String
  ownerUid        String
  ownerEmail      String
  ownerName       String
  shopName        String
  status          ReactivationRequestStatus  @default(pending)
  rejectionReason String?
  resolvedBy      String?

  requestedAt DateTime @default(now())
  resolvedAt  DateTime?

  // ── Relations ──
  shop  Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  owner User @relation(fields: [ownerUid], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([status])
  @@map("reactivation_requests")
  // A partial unique index enforces one *pending* request per shop:
  //   CREATE UNIQUE INDEX ... ON ("shopId") WHERE "status" = 'pending'
  // Declared in migration 20260802200000_one_pending_reactivation_per_shop
  // because Prisma's schema language cannot express a partial index. Resolved
  // requests are deliberately unconstrained — a shop may be archived and
  // reinstated any number of times, and each of those is a record worth
  // keeping.
}

/// Refund request — student requests, shop/admin resolves
model RefundRequest {
  id               String              @id @default(cuid())
  orderId          String              @unique
  studentId        String
  shopId           String
  reason           String
  status           RefundRequestStatus @default(PENDING_SHOP)
  refundAmount     Int?
  razorpayRefundId String?

  /// How many refund attempts the gateway has *failed* on this request.
  ///
  /// Counts abandoned attempts, not started ones, and is incremented only when
  /// a refund is confirmed failed. The attempt now live is therefore
  /// `attempts + 1`, and every idempotency key derived from this request — the
  /// Razorpay `X-Refund-Idempotency` header and the shop's `REFUND_DEDUCTION`
  /// ledger `eventId` — carries that number.
  ///
  /// Both halves of that matter:
  ///
  ///  - Keying on the request id alone meant a retry after a failure presented
  ///    the key of the refund Razorpay had already failed, got that dead refund
  ///    back, and issued nothing — while the ledger deduped the shop's
  ///    deduction away, so nobody was charged for the refund either.
  ///  - Counting *starts* rather than *failures* would break the opposite case:
  ///    an attempt that succeeded at the gateway but lost its local transaction
  ///    must retry under the same key, or the student is refunded twice.
  attempts         Int                 @default(0)

  // Response tracking
  shopResponse   String?
  adminNote      String?
  resolvedBy     String?

  // Timestamps
  studentRequestedAt DateTime @default(now())
  shopRespondedAt    DateTime?
  adminResolvedAt    DateTime?

  // ── Relations ──
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  student User  @relation("RefundStudent", fields: [studentId], references: [id], onDelete: Cascade)
  shop    Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([shopId])
  @@index([status])
  @@map("refund_requests")
}

/// Webhook event log — Upgrade A: idempotent, auditable webhook processing.
///
/// Every incoming Razorpay webhook is logged here BEFORE any business logic runs.
/// The unique eventId constraint prevents double-processing.
/// If the server crashes mid-processing, unprocessed events can be replayed
/// via the reconciliation job (Upgrade B).
model WebhookEvent {
  id              String   @id @default(cuid())
  source          String   // 'razorpay'
  eventId         String   @unique // Razorpay's event.id — dedup key
  eventType       String   // 'payment.captured', 'payment.failed', etc.
  razorpayOrderId String?  // For quick lookups during reconciliation
  payload         Json     // Full raw webhook payload
  processed       Boolean  @default(false)
  processingError String?  // Error message if processing failed
  processedAt     DateTime?

  /// Set by whichever delivery is currently processing this event.
  ///
  /// `processed` alone cannot serialize two concurrent deliveries: it is read
  /// before the work starts and written after, so both see false and both run.
  /// Claiming is a compare-and-swap on this column, and a claim older than the
  /// TTL is reclaimable so a crashed processor cannot strand the event.
  claimedAt       DateTime?
  /// Failed processing attempts. Retries stop at MAX_WEBHOOK_ATTEMPTS so a
  /// permanently unprocessable event is escalated once instead of being
  /// re-attempted by every reconciliation pass forever.
  attempts        Int      @default(0)

  createdAt DateTime @default(now())

  @@index([processed, createdAt])
  /// The reconciliation sweep selects unprocessed events that still have
  /// retries left, so it filters on both columns together.
  @@index([processed, attempts])
  @@index([razorpayOrderId])
  @@map("webhook_events")
}

/// One Student Pass checkout.
///
/// A pass purchase used to have no row at all. A print order is protected from
/// being paid for twice by two things — the compare-and-swap on
/// `orders.paymentAttemptedAt` and the unique index on
/// `orders.razorpayOrderId` — and a pass had neither, because there was nothing
/// to put them on. The only guard was "is a pass currently active", which is
/// false for every first purchase and every renewal after expiry, so two
/// checkouts started in that state both minted a real gateway order and both
/// could be captured.
///
/// This is that missing row, and it carries all four things the absence cost:
///
///  - a partial unique index on `userId WHERE status = 'OPEN'`, so a second
///    open checkout is refused by Postgres rather than by a timer;
///  - `razorpayOrderId @unique`, so one gateway order maps to one purchase;
///  - a durable record of *every* payment, so a second capture can no longer
///    overwrite the first beyond recovery; and
///  - something for `auditCapturedPayments` to check a pass payment against,
///    which is why it no longer has to skip them.
model StudentPassPurchase {
  id     String                    @id @default(cuid())
  userId String
  status StudentPassPurchaseStatus @default(OPEN)

  /// Null only between claiming the checkout and the gateway answering. Unique
  /// so one Razorpay order can never belong to two purchases; Postgres permits
  /// many NULLs in a unique index, so in-flight rows are unaffected.
  razorpayOrderId   String? @unique
  /// Set when the payment is captured. Unique for the same reason.
  razorpayPaymentId String? @unique
  /// What the pass cost when this checkout was minted. Read back at capture, so
  /// a price change mid-checkout is judged against what the student was quoted
  /// rather than against what the price happens to be when the webhook lands.
  amountPaise       Int

  /// When an unpaid checkout stops holding the one open slot.
  expiresAt DateTime
  /// Start of the pass window this purchase bought. Null until it is applied.
  appliedFrom DateTime?
  /// Why a captured purchase was refused, for the human who has to sort it out.
  refusedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Relations ──
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  /// Drives the sweep that abandons checkouts nobody paid for.
  @@index([status, expiresAt])
  @@map("student_pass_purchases")
  // A partial unique index enforces one *open* checkout per user:
  //   CREATE UNIQUE INDEX ... ON ("userId") WHERE "status" = 'OPEN'
  // Declared in migration 20260827090000_student_pass_purchase because Prisma's
  // schema language cannot express a partial index. Resolved purchases are
  // deliberately unconstrained — a student may buy a pass every month for
  // years, and each of those is a record worth keeping.
}

/// Earnings report metadata (the actual report files are stored in S3/R2)
model EarningsReport {
  id            String @id @default(cuid())
  type          String
  startDate     String
  endDate       String
  totalOrders   Int    @default(0)
  totalRevenue  Int  @default(0)
  totalBaseFees Int  @default(0)
  totalPageCosts Int @default(0)
  storagePath   String
  downloadUrl   String
  generatedBy   String

  generatedAt DateTime @default(now())

  @@map("earnings_reports")
}

/// Referral codes generated by admins for shop owner registration
model ReferralCode {
  id        String    @id @default(cuid())
  /// Admin User ID. Nullable so deleting an admin cannot destroy the record of
  /// which codes they issued — the code outlives the account that made it.
  createdBy String?
  code      String    @unique
  usedBy    String?   @unique // Shop Owner User ID
  /// The consumption fact, and the single-use guard. Kept separate from
  /// `usedBy` because that column goes null if the owner's account is deleted,
  /// and a code must not become redeemable again when that happens.
  usedAt    DateTime?
  expiresAt DateTime? // Optional expiration date

  createdAt DateTime  @default(now())

  // ── Relations ──
  // Both SetNull rather than Cascade: these rows are the only record of which
  // admin authorised which stranger to register as a shop owner and take money.
  // Deleting either account should cost the name, not the record.
  creator User? @relation("ReferralCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  user    User? @relation("ReferralUser", fields: [usedBy], references: [id], onDelete: SetNull)

  @@index([code, usedBy])
  /// Drives the sweep for codes that expired without ever being redeemed.
  @@index([usedAt, expiresAt])
  @@map("referral_codes")
}

/// OTP tokens for sensitive admin/account actions (delete, archive, etc.)
model AdminOtp {
  id             String   @id @default(cuid())
  userId         String
  otp            String
  actionId       String
  expiresAt      DateTime
  failedAttempts Int      @default(0)
  lockUntil      DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, actionId])
  @@index([userId])
  @@map("admin_otps")
}

// ─────────────────────────────────────────────────────────────
// OBSERVABILITY — what broke, what we did about it, and whether
// the background jobs are actually running.
//
// These tables live in the same database as everything else, which
// is a deliberate limitation to understand: when Postgres itself is
// down, nothing here records anything. That is why the alert path
// (alert.service) can deliver without touching the database, and why
// an external uptime check outside this process is not optional.
// What these tables are good for is the far more common case — the
// database is fine and the application is not.
// ─────────────────────────────────────────────────────────────

enum SystemEventSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

/// A distinct thing that went wrong, aggregated by fingerprint.
///
/// One row per fingerprint rather than per occurrence: a broken endpoint hit
/// 400 times is one defect, and storing it 400 times buys nothing but a table
/// that has to be swept more often. `count` and `lastSeenAt` carry the volume.
model SystemEvent {
  id String @id @default(cuid())

  /// Stable hash of (source + normalized message). Two occurrences of the same
  /// defect must produce the same fingerprint even though their messages differ
  /// in ids, amounts and timestamps — see fingerprint() in observability.service.
  fingerprint String              @unique
  severity    SystemEventSeverity
  /// Subsystem that reported it: 'http', 'scheduler', 'payment', 'process', …
  source      String
  message     String
  /// Truncated stack, request path, job name — whatever helps diagnose. Never
  /// request bodies: they carry tokens, and this table is read by the frontend.
  context     Json?

  count      Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  /// Set when an operator marks it handled. Resolved events stop alerting; a
  /// new occurrence after resolution clears this and alerts again, because a
  /// defect that comes back is news.
  resolvedAt DateTime?
  resolvedBy String?

  /// Last time an alert went out for this fingerprint — enforces the cooldown
  /// across restarts, which an in-memory timer cannot do on a host that sleeps.
  lastAlertedAt DateTime?

  @@index([resolvedAt, lastSeenAt])
  @@index([severity, lastSeenAt])
  @@map("system_events")
}

/// Last completed run of each background job.
///
/// The scheduler's own logs say a job started; only this says it finished. On a
/// host that sleeps, "the settlement sweep has not completed in six hours" is
/// the single most useful signal available, and it cannot be derived from
/// anything else we store.
model JobHeartbeat {
  /// Job name, matching the string passed to schedule() in scheduler.service.
  name String @id

  lastStartedAt   DateTime?
  lastSucceededAt DateTime?
  lastFailedAt    DateTime?
  lastError       String?
  /// Milliseconds the last successful run took. A job that still completes but
  /// takes 40x longer than usual is a warning ahead of an outage.
  lastDurationMs  Int?
  consecutiveFailures Int @default(0)

  /// Lease held by the instance currently running this job, and when it lapses.
  ///
  /// Replaces the Postgres session-level advisory lock the scheduler used to
  /// take. `pg_try_advisory_lock` and `pg_advisory_unlock` are scoped to a
  /// session, and at runtime this connects through Neon's PgBouncer pooler
  /// (see the `directUrl` note at the top of this file), where a session is not
  /// pinned across statements — so the unlock could land on a different backend
  /// than the lock, silently fail, and leave the job locked forever. Every
  /// later run then read that as "another instance is running it" and skipped,
  /// which would have stopped settlement, reconciliation and the payment audit
  /// dead with nothing logged.
  ///
  /// A lease is used rather than a transaction-scoped advisory lock because
  /// holding a transaction open for a job's whole duration pins a pooled
  /// connection, and several of these jobs open their own transactions while
  /// running — with a connection limit of 10 that is a route to the pool
  /// deadlocking on itself. A lease row needs no connection held at all, and
  /// expires on its own if the process dies.
  lockedUntil DateTime?
  lockedBy    String?

  updatedAt DateTime @updatedAt

  @@map("job_heartbeats")
}

enum RemediationOutcome {
  /// Precondition no longer held when the action was about to run — the problem
  /// resolved itself between detection and action. Not a failure.
  SKIPPED
  SUCCEEDED
  FAILED
  /// Circuit was open; no attempt was made.
  BLOCKED
}

/// Every automatic action the watchdog took, successful or not.
///
/// An append-only audit log. The watchdog is allowed to act on production
/// without a human, so the non-negotiable price is that every action it takes
/// is reconstructable afterwards — what it saw, what it did, what happened.
model RemediationLog {
  id String @id @default(cuid())

  /// Which remediation ran, e.g. 'redispatch-outbox', 'force-reconciliation'.
  action String
  /// Fingerprint of the condition that triggered it, for correlation with
  /// system_events.
  trigger String
  outcome RemediationOutcome
  /// What the check saw at decision time, and what the action changed.
  detail  Json?
  durationMs Int?

  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@index([createdAt])
  @@map("remediation_log")
}

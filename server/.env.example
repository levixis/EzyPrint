# ─────────────────────────────────────────────────────────────
# EzyPrint backend environment
#
# Copy to .env and fill in. Every value marked REQUIRED must be set
# outside NODE_ENV=development or the server refuses to start.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000

# Number of reverse proxies in front of the app (Railway/Vercel edge = 1).
# Rate limiting keys on the wrong address if this is unset behind a proxy.
TRUST_PROXY_HOPS=1

# ── Database (Neon) ──
# DATABASE_URL: the POOLED endpoint (note the `-pooler` in the host). Used at runtime.
# DIRECT_URL:   the DIRECT endpoint (no `-pooler`). Used by `prisma migrate` only —
#               PgBouncer cannot hold the session locks migrations need.
DATABASE_URL="postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&connection_limit=10&pool_timeout=30"
DIRECT_URL="postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ── JWT — REQUIRED. Generate with: openssl rand -base64 48 ──
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── CORS — frontend origin(s), comma-separated ──
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# ── Google OAuth — REQUIRED ──
# Comma-separated OAuth client IDs that tokens may be issued for, checked
# against the token's `aud` claim. Without this, a Google token minted for any
# other application would be accepted as a valid EzyPrint login.
# Include every client the app ships with (web, Android, iOS).
GOOGLE_CLIENT_IDS="283831997162-p8afki1sjtfa9srdvr6infpf06gofmk5.apps.googleusercontent.com"

# ── Razorpay — REQUIRED ──
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook HMAC secret. If unset, payment webhooks cannot be verified.
RAZORPAY_WEBHOOK_SECRET=""

# ── File storage — Cloudflare R2 (S3-compatible) ──
STORAGE_MODE="local"          # "local" for dev, "s3" for R2 in production
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""                # https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
LOCAL_UPLOAD_DIR="uploads"

# ── Email (Gmail SMTP, for admin OTP) ──
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# ── Pusher — REQUIRED (real-time shop ledger) ──
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="ap2"          # ap2 = Mumbai

# ── Push notifications (FCM) ──
# Firebase service account JSON, used ONLY as an FCM transport — no Firestore,
# no Auth. Accepts raw JSON or base64; prefer base64, because the private key is
# multi-line and a dashboard env field will mangle or truncate it.
#
# Mint one with:
#   gcloud iam service-accounts keys create key.json \
#     --iam-account=firebase-adminsdk-fbsvc@<project>.iam.gserviceaccount.com \
#     --project=<project>
#   base64 -i key.json | tr -d '\n'
# (or Firebase Console → Project Settings → Service Accounts → Generate new
# private key)
#
# Optional by design. Leaving it empty disables the device buzz and leaves
# in-app notifications working, rather than taking the server down — the
# Notification row is the durable record, the push is a courtesy copy.
FIREBASE_SERVICE_ACCOUNT=""

# ── Settlement ──
# Hours an earning stays in "clearing" before becoming withdrawable, and the
# hour of day (IST) it is released. Together these let the dashboard promise an
# exact availability time the moment an order is completed.
SETTLEMENT_DELAY_HOURS=24
SETTLEMENT_RELEASE_HOUR_IST=6

# ── Background scheduler ──
# Settlement sweep, Razorpay reconciliation, and real-time outbox dispatch all
# run in-process, guarded by a Postgres advisory lock so multiple instances
# cannot double-run them.
ENABLE_SCHEDULER=true
SETTLEMENT_SWEEP_INTERVAL_MS=300000
RECONCILE_INTERVAL_MS=900000
OUTBOX_DISPATCH_INTERVAL_MS=10000
# Retry file deletions the inline purge missed (hourly).
FILE_RETENTION_SWEEP_INTERVAL_MS=3600000
# Delete referral codes that expired unredeemed (daily). Codes carry a 7-day
# expiry and then a 30-day grace period, so nothing here is urgent to the hour.
REFERRAL_SWEEP_INTERVAL_MS=86400000

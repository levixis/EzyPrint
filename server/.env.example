# Environment
NODE_ENV=development
PORT=5000

# Database — update with your local PostgreSQL credentials
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ezyprint?schema=public"

# JWT Secrets — generate strong random strings for production
JWT_ACCESS_SECRET="your-access-secret-change-me"
JWT_REFRESH_SECRET="your-refresh-secret-change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS — frontend URL(s), comma-separated
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Razorpay (keep your existing keys)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# File Storage — S3/R2 (Phase 4)
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_REGION=""

# ─────────────────────────────────────────────────────────────
# EzyPrint backend environment
#
# Copy to .env and fill in. Every value marked REQUIRED must be set
# outside NODE_ENV=development or the server refuses to start.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000

# Number of reverse proxies in front of the app (Railway/Vercel edge = 1).
# Rate limiting keys on the wrong address if this is unset behind a proxy.
TRUST_PROXY_HOPS=1

# ── Database (Neon) ──
# DATABASE_URL: the POOLED endpoint (note the `-pooler` in the host). Used at runtime.
# DIRECT_URL:   the DIRECT endpoint (no `-pooler`). Used by `prisma migrate` only —
#               PgBouncer cannot hold the session locks migrations need.
DATABASE_URL="postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&connection_limit=10&pool_timeout=30"
DIRECT_URL="postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ── JWT — REQUIRED. Generate with: openssl rand -base64 48 ──
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── CORS — frontend origin(s), comma-separated ──
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# ── Google OAuth — REQUIRED ──
# Comma-separated OAuth client IDs that tokens may be issued for, checked
# against the token's `aud` claim. Without this, a Google token minted for any
# other application would be accepted as a valid EzyPrint login.
# Include every client the app ships with (web, Android, iOS).
GOOGLE_CLIENT_IDS="283831997162-p8afki1sjtfa9srdvr6infpf06gofmk5.apps.googleusercontent.com"

# ── Razorpay — REQUIRED ──
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook HMAC secret. If unset, payment webhooks cannot be verified.
RAZORPAY_WEBHOOK_SECRET=""

# ── File storage — Cloudflare R2 (S3-compatible) ──
STORAGE_MODE="local"          # "local" for dev, "s3" for R2 in production
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""                # https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
LOCAL_UPLOAD_DIR="uploads"

# ── Email (admin OTP) ──
# Two transports, tried in order: HTTPS first when RESEND_API_KEY is set, then
# SMTP. Whichever is configured is used; if both are, a failure of one falls
# through to the other.
#
# RESEND_API_KEY is required on Render's FREE tier, which blocks outbound
# traffic to SMTP ports 25/465/587 — Gmail credentials cannot deliver from
# there however correct they are. Paid instances allow 465 and 587.
#
# EMAIL_FROM must be on a domain verified with the provider. Resend's
# onboarding@resend.dev works with no setup but only delivers to the address
# that owns the Resend account, so the server REFUSES TO START in production
# with a resend.dev sender — password resets, payout OTPs and account-deletion
# codes would all report success and arrive nowhere.
#
# Production value: "EzyPrint <noreply@ezyprint.co.in>", after the SPF, DKIM
# and DMARC records for ezyprint.co.in are verified in the Resend dashboard.
RESEND_API_KEY=""
EMAIL_FROM=""
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# ── Alerting ──
# Where the monitoring system sends operational alerts. This is the address
# that gets woken up, and it is read from the environment rather than from the
# admin users table on purpose: alerts fire when things are broken, and
# "query the database for admins" is a step that fails during a database
# outage.
#
# In production this falls back to GMAIL_USER when unset. In development it
# does NOT — leave it empty locally and no alert mail is sent at all. A laptop
# that sleeps stops the scheduler and drops its database connection, which
# generates a steady stream of alerts that mean nothing and teach you to
# ignore the channel. Set it locally only when you are deliberately testing
# the alert path.
ALERT_EMAIL=""
# Minimum gap between two alerts about the same fault, and a hard ceiling per
# hour across all faults. The failure mode of alerting is volume, not silence:
# a channel that emits 300 identical messages gets muted, and then you believe
# you have monitoring you no longer have.
ALERT_COOLDOWN_MS="900000"
ALERT_MAX_PER_HOUR="12"
SYSTEM_EVENT_RETENTION_DAYS="30"

# ── Watchdog (automatic recovery) ──
# Master switch for the ACTING half of the monitoring system. Detection,
# health reporting and alerting are unaffected by this — turning it off leaves
# you fully informed and merely un-helped, which is the state you want while
# diagnosing something the watchdog itself might be implicated in.
ENABLE_WATCHDOG="true"
WATCHDOG_INTERVAL_MS="120000"
# Consecutive failures of one remediation before its circuit opens, it stops
# being attempted, and a human is alerted instead.
WATCHDOG_CIRCUIT_THRESHOLD="3"
WATCHDOG_CIRCUIT_COOLDOWN_MS="1800000"
# A background job counts as stalled after this many times its own interval
# with no completed run. Three tolerates two missed ticks, which a cold start
# or a slow Neon wake can legitimately cause.
WATCHDOG_STALL_MULTIPLIER="3"
# Consecutive failing cycles before a human is told. Remediation still runs on
# the first failure — only waking someone waits for confirmation. Two, because
# Neon closes idle connections and suspends on the free tier, so a single cycle
# can fail and the next one reconnects and passes.
WATCHDOG_ESCALATE_AFTER="2"

# ── Pusher — REQUIRED (real-time shop ledger) ──
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="ap2"          # ap2 = Mumbai

# ── Push notifications (FCM) ──
# Firebase service account JSON, used ONLY as an FCM transport — no Firestore,
# no Auth. Accepts raw JSON or base64; prefer base64, because the private key is
# multi-line and a dashboard env field will mangle or truncate it.
#
# Mint one with:
#   gcloud iam service-accounts keys create key.json \
#     --iam-account=firebase-adminsdk-fbsvc@<project>.iam.gserviceaccount.com \
#     --project=<project>
#   base64 -i key.json | tr -d '\n'
# (or Firebase Console → Project Settings → Service Accounts → Generate new
# private key)
#
# Optional by design. Leaving it empty disables the device buzz and leaves
# in-app notifications working, rather than taking the server down — the
# Notification row is the durable record, the push is a courtesy copy.
FIREBASE_SERVICE_ACCOUNT=""

# ── Settlement ──
# Hours an earning stays in "clearing" before becoming withdrawable, and the
# hour of day (IST) it is released. Together these let the dashboard promise an
# exact availability time the moment an order is completed.
#
# T+1: everything earned on a day is released at the release hour the next
# morning, whatever time the order was completed. Counted in days rather than
# hours on purpose — a fixed hour-delay rounded up to a fixed release hour
# compounds into a cliff, where two orders minutes apart wait a day apart.
SETTLEMENT_DELAY_DAYS=1
SETTLEMENT_RELEASE_HOUR_IST=6

# ── Background scheduler ──
# Settlement sweep, Razorpay reconciliation, and real-time outbox dispatch all
# run in-process, guarded by a Postgres advisory lock so multiple instances
# cannot double-run them.
ENABLE_SCHEDULER=true
SETTLEMENT_SWEEP_INTERVAL_MS=300000
RECONCILE_INTERVAL_MS=900000
OUTBOX_DISPATCH_INTERVAL_MS=10000
# Ask Razorpay how the refunds we are still waiting on actually ended.
#
# A refund stays PROCESSING_REFUND until the gateway confirms it, because
# Razorpay accepting a refund is not Razorpay settling one. Confirmation arrives
# on the refund.processed / refund.failed webhooks — which are ticked by hand in
# the dashboard, separately per mode, and have never delivered an event here.
# Until they do, this poll is the only thing that ends a refund: without it the
# student is told their money is on the way and never told it arrived, the shop
# is never debited, and the order's files stay pinned by the unsettled refund.
REFUND_RECONCILE_INTERVAL_MS=900000
# Grace period before a refund is worth asking about. Not a deadline — Razorpay
# usually settles in minutes but may take days, and anything the gateway still
# calls pending is left exactly as it is.
REFUND_STUCK_MINUTES=30
# Retry file deletions the inline purge missed (hourly).
FILE_RETENTION_SWEEP_INTERVAL_MS=3600000
# Delete referral codes that expired unredeemed (daily). Codes carry a 7-day
# expiry and then a 30-day grace period, so nothing here is urgent to the hour.
REFERRAL_SWEEP_INTERVAL_MS=86400000

# ── Shop-initiated refunds ──
# How much a shop can refund on its own authority before an admin is required.
# A refund returns money to the payer's original card/UPI, so an abused shop
# account cannot extract anything with one — these bound the blast radius
# rather than the permission. Over any limit the claim escalates to an admin.
SHOP_REFUND_MAX_PER_REFUND_PAISE=50000
SHOP_REFUND_MAX_PER_DAY_COUNT=10
SHOP_REFUND_MAX_PER_DAY_PAISE=200000
